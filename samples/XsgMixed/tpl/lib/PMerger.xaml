<UserControl x:Class="@NS@.@P@Merger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/@OTHER@;component/@Q@Dict.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <TextBlock x:Name="T" Text="{StaticResource @Q@Text}" Foreground="{StaticResource @Q@Brush}" />
</UserControl>
