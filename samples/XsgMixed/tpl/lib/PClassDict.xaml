<ResourceDictionary x:Class="@NS@.@P@ClassDict"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="@P@ClassBrush" Color="#778899" />
  <SolidColorBrush x:Key="@P@ClassShared" x:Shared="False" Color="#334455" />
  <Style x:Key="@P@ClassStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource @P@ClassBrush}" />
  </Style>
</ResourceDictionary>
