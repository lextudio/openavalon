<UserControl x:Class="@NS@.@P@Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Local" Color="#FF0000" />
  </UserControl.Resources>
  <Border x:Name="Root" Background="{StaticResource Local}" Padding="4">
    <StackPanel>
      <TextBlock x:Name="Label" Text="@P@ control" Foreground="{DynamicResource @P@Brush}" />
      <Button x:Name="Btn" Content="b" />
    </StackPanel>
  </Border>
</UserControl>
