<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><StartupObject>App@MODE@.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LibX/LibX.csproj" />
    <ProjectReference Include="../LibB/LibB.csproj" />
  </ItemGroup>
