<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config><add key="globalPackagesFolder" value="../XsgNativeAot/packages" /></config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="openavalon" value="../../../OpenDevelop/artifacts/openavalon-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="openavalon"><package pattern="LibreWPF.*" /><package pattern="LibreWinForms.*" /><package pattern="ProGPU.*" /></packageSource>
  </packageSourceMapping>
</configuration>
