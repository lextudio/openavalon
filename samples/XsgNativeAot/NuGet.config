<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Private package folder: prepare.sh patches the locally built LibreWPF assemblies into it, never into a shared cache. -->
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The OpenAvalon closure as OpenDevelop syncs it from GitHub Packages (sync-openavalon-feed.ps1). -->
    <add key="openavalon" value="../../../OpenDevelop/artifacts/openavalon-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="openavalon">
      <package pattern="LibreWPF.*" />
      <package pattern="LibreWinForms.*" />
      <package pattern="ProGPU.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
