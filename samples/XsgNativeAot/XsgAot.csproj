<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseLibreWpfXamlSourceGenerator>true</UseLibreWpfXamlSourceGenerator>
    <ProGpuWpfUseWpfMarkup>false</ProGpuWpfUseWpfMarkup>
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Theme/**" />
    <AdditionalFiles Include="MainWindow.xaml" />
    <AdditionalFiles Include="App.xaml" />
    <AdditionalFiles Include="Card.xaml" />
    <AdditionalFiles Include="Gallery.xaml" />
    <AdditionalFiles Include="Dynamics.xaml" />
    <AdditionalFiles Include="Page1.xaml" />
    <AdditionalFiles Include="Themes/Generic.xaml" />
    <AdditionalFiles Include="Styles/Brushes.xaml" />
    <Resource Include="Assets/logo.png" />
    <ProjectReference Include="Theme/XsgAot.Theme.csproj" />
  </ItemGroup>
  <Import Project="XsgLocal.targets" />
</Project>
