<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseLibreWpfXamlSourceGenerator>true</UseLibreWpfXamlSourceGenerator>
    <ProGpuWpfUseWpfMarkup>false</ProGpuWpfUseWpfMarkup>
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Theme/**" />
    <Compile Remove="ThemeEquivalence/**" />
    <AdditionalFiles Include="MainWindow.xaml" />
    <AdditionalFiles Include="App.xaml" />
    <AdditionalFiles Include="Card.xaml" />
    <AdditionalFiles Include="Gallery.xaml" />
    <AdditionalFiles Include="Dynamics.xaml" />
    <AdditionalFiles Include="Page1.xaml" />
    <AdditionalFiles Include="Misc.xaml" />
    <RdXmlFile Include="rd.xml" />
    <AdditionalFiles Include="Themes/Generic.xaml" />
    <AdditionalFiles Include="Styles/Brushes.xaml" />
    <Resource Include="Assets/logo.png" />
    <!-- The theme: this sample's own XSG theme project, or (property UseInBoxXsgTheme=true) the in-box PresentationFramework.Aero2 that LibreWPF built with LibreWpfXsgThemes=true,
         patched into the private packages by prepare.sh with its inbox-xsg-aero2 option (two dashes in front). -->
    <ProjectReference Include="Theme/XsgAot.Theme.csproj" Condition="'$(UseInBoxXsgTheme)' != 'true'" />
    <TrimmerRootAssembly Include="PresentationFramework.Aero2" Condition="'$(UseInBoxXsgTheme)' == 'true'" />
  </ItemGroup>
  <!-- Opt in (-p:UseDevFlow=true): the LibreWPF DevFlow agent (automation, UI tree, screenshots over HTTP) with XSGAOT_DEVFLOW=<port> at run time. The package comes from
       GitHub Packages; download it to a folder and add that folder with -p:RestoreAdditionalProjectSources=<folder>. -->
  <PropertyGroup Condition="'$(UseDevFlow)' == 'true'">
    <DefineConstants>$(DefineConstants);XSGAOT_DEVFLOW</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseDevFlow)' == 'true'">
    <PackageReference Include="LeXtudio.DevFlow.Agent.LibreWpf" Version="$(DevFlowVersion)" />
  </ItemGroup>
  <PropertyGroup>
    <DevFlowVersion Condition="'$(DevFlowVersion)' == ''">0.3.2-preview.13</DevFlowVersion>
  </PropertyGroup>
  <Import Project="XsgLocal.targets" />
</Project>
