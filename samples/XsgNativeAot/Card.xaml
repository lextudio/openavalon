<UserControl x:Class="XsgAot.Card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="{StaticResource CardPadding}">
    <TextBlock x:Name="Caption" Text="card" />
  </Border>
</UserControl>
