<Project Sdk="LibreWPF.Sdk">
  <!-- Loads the in-box BAML Aero2 dictionary and the XSG-compiled one (Theme/XsgAot.Theme) in one JIT process and compares them: the gate for
       compiling the in-box themes with the XAML source generator (plan D1, option A). Run: dotnet run -c Release. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Theme/XsgAot.Theme.csproj" />
  </ItemGroup>
</Project>
